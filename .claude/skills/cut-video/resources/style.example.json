{
  "edit_route": {
    "default": "ask",
    "fallback": "ffmpeg",
    "why": "resolve | ffmpeg | ask. Read by the agent (references/edit-route.md), ignored by the engine."
  },
  "platforms": [
    "instagram_reels",
    "youtube_shorts",
    "tiktok"
  ],
  "source": {
    "lut": "/path/to/grade.cube",
    "eq": "contrast=1.14:saturation=1.35:brightness=-0.015"
  },
  "cover": {
    "font": "/path/to/fonts/Display-Regular.ttf",
    "color": "#F2EDE0",
    "size": 72,
    "case": "as-is",
    "anchor": "center",
    "seconds": 2.0
  },
  "captions": {
    "font": "/path/to/fonts/Body-Medium.ttf",
    "size": 56,
    "style": "phrase",
    "placement": "safe-lower",
    "max_chars_per_line": 32,
    "min_cue_s": 0.8,
    "max_cue_s": 2.8
  },
  "audio": {
    "loudnorm": "two-pass",
    "target_i": -16,
    "true_peak": -1.5,
    "lra": 11
  },
  "render": {
    "encoder": "auto",
    "preset": "fast",
    "crf": 18
  },
  "qa": {
    "frames": true,
    "contact_sheet": true,
    "max_frame_px": 540
  },
  "broll_defaults": {
    "dur_still": 3.5,
    "dur_clip": 2.5,
    "zoom": 1.1,
    "direction": "in"
  },
  "resolve": {
    "_about": "Read only by the resolve-reel skill (render-reel.py drops this block). Keys left out use resolve-reel's defaults.",
    "grade": {
      "camera_input": "Canon Cinema Gamut/Canon Log 3",
      "look_profile": "resources/video-pipeline/look.json",
      "lut_resolve": "MCP/house-look.cube",
      "face_ire": 55,
      "black_code": 14,
      "sat": 0.68,
      "wb_target_709": [
        1.02,
        1.0,
        0.97
      ],
      "vignette": 0.035,
      "voice_gain_db": 5.0
    },
    "cover_shadow": {
      "y": 2,
      "blur": 24,
      "alpha": 0.45
    }
  }
}
